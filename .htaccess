RewriteEngine On
RewriteBase /

# Exclude invoice print routes from rewrite
RewriteCond %{QUERY_STRING} (^|&)print-order= [NC]
RewriteRule ^ - [L]

# www (http or https) goes straight to the final address in one hop
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Force SSL
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Proxy all requests to the Node.js application on port 3000
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

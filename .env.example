# CHILS & CO. - Environment Configuration

# Application Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://www.chilsandco.com

# WooCommerce Integration (Critiical for Live Data)
# Get these from WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_URL=https://www.chilsandco.com
WOOCOMMERCE_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Authentication
# This MUST match the JWT_AUTH_SECRET_KEY in your WordPress wp-config.php/plugin settings
JWT_SECRET=replace-with-a-new-random-value

# RMA Plugin API Key
RMA_API_SECRET=replace-with-a-new-random-value

# PhonePe Integration
# Get these from your PhonePe Dashboard
# Standard Checkout SDK credentials (V4)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Basic Auth for Webhooks/Callbacks (Optional, configured in PhonePe Dashboard)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Legacy/Pay Page Integration (Hermes)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=PRODUCTION
# Optional: The URL PhonePe will post results to. Defaults to /api/checkout/phonepe/callback
PHONEPE_CALLBACK_URL=https://api.chilsandco.com/api/checkout/phonepe/callback
# PHONEPE_BASE_URL=

# Brevo SMTP API Key
BREVO_API_KEY=

# Shiprocket Logistics Integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=replace-with-a-new-random-value

# WhatsApp Cloud API Integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Google Gemini AI Integration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Meta Pixel + Conversions API (Events Manager > Data sources > your Pixel)
# The Pixel ID is public; it is read at build time by the site and at runtime by the server.
VITE_META_PIXEL_ID=
# Settings > Conversions API > Generate access token. Server only, keep it secret.
META_CAPI_TOKEN=
# Optional: set while checking events in Events Manager > Test events, then remove.
META_TEST_EVENT_CODE=
